# Vercel > Project > Settings > Environment Variables.
# Copy the URL and publishable key from your EXISTING Supabase project.
SUPABASE_URL=https://pgoypntgazhwacbuikzl.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# This must be the existing application-ingest signing secret from the database.
# Do not generate a different value for Vercel: the two sides must match.
APPLICATION_INGEST_SECRET=

# Public website address (not a secret).
NEXT_PUBLIC_SITE_URL=https://evzonchatting.com

# Never place SMTP passwords, Supabase service-role keys, or secret API keys here.
# The chatter provisioning Edge Function receives its privileged key in Supabase.

# GA4 web stream ID. Already configured as the application default.
# Set an empty string to disable analytics in a build.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-15PY8YRJ87
